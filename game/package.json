{
  "name": "alchemy-arena",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Zero-install browser alchemy battler: craft elements with an in-browser LLM, battle with a deterministic engine.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "fix": "biome check --write .",
    "check": "biome check . && tsc --noEmit && vitest run",
    "eval:craft": "vitest run eval/craft-eval.test.ts"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.84"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/node": "^24.10.13",
    "fast-check": "^4.9.0",
    "jsdom": "^28.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
