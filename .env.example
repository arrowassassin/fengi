# Server-side only. Core gameplay never requires a key.
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
# Explicit opt-in for private authoring. Never enable this to imply production rights.
FENGI_AI_ENABLED=false
# Optional: absolute persistent disk path. Defaults to .data/fengi.sqlite.
# FENGI_DATABASE_PATH=/absolute/path/to/fengi.sqlite
# Required behind a production reverse proxy: exact public HTTPS origin.
# FENGI_ORIGIN=https://games.example.com
# Public binding also requires a trusted proxy-overwritten single-IP header.
# Never expose the upstream port or accept this header directly from clients.
# FENGI_CLIENT_IP_HEADER=x-fengi-client-ip
# FENGI_HOST=0.0.0.0
