{
  "name": "fengi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "node --env-file-if-exists=.env.local scripts/start.mjs",
    "lint": "biome check src tests scripts *.json *.ts",
    "format": "biome check --write src tests scripts *.json *.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "content:verify-live": "node --env-file-if-exists=.env.local --import tsx scripts/verify-live-content.ts",
    "content:draft": "node --env-file-if-exists=.env.local --import tsx scripts/draft-content.ts",
    "db:backup": "node --env-file-if-exists=.env.local --import tsx scripts/backup.ts",
    "db:verify": "node --import tsx scripts/verify-backup.ts",
    "db:cleanup": "node --env-file-if-exists=.env.local --import tsx scripts/cleanup.ts",
    "content:editorial": "node --env-file-if-exists=.env.local --import tsx scripts/editorial.ts",
    "content:verify-play": "node --env-file-if-exists=.env.local --import tsx scripts/verify-live-play.ts",
    "db:restore": "node --import tsx scripts/restore.ts"
  },
  "dependencies": {
    "@langchain/core": "1.3.4",
    "@langchain/openai": "1.8.0",
    "better-sqlite3": "13.0.3",
    "next": "16.4.5",
    "phaser": "4.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
